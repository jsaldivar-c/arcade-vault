# Resend (https://resend.com) — usado por app/api/contact/route.ts para enviar
# el correo del formulario de contacto. Crea una cuenta y una API key en
# https://resend.com/api-keys y pégala aquí.
RESEND_API_KEY=XXXXXXXXXXXX

# Dirección que recibe los mensajes enviados desde el formulario de contacto.
CONTACT_TO_EMAIL=email@gmail.com

# Supabase
SUPABASE_DB_PASSWORD=XXXXXXXXXXXX

# URL del proyecto Supabase (Project Settings → API). Pública, se expone al cliente.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Publishable key del proyecto (Project Settings → API → Publishable key, sb_publishable_...).
# Pública, diseñada para usarse en el cliente — no confundir con la secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXX
